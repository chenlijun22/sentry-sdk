{
  "name": "channelwill-sentry-sdk",
  "version": "0.2.7",
  "type": "module",
  "description": "基于 Sentry React SDK 的二次封装，方便快速上手",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.esm.js",
      "require": "./dist/runtime.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.esm.js",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.esm.js",
      "require": "./dist/webpack.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "ROLLUP_WATCH=1 rollup -c -w",
    "prepublishOnly": "npm run build && npm run clean:maps",
    "clean:maps": "find dist -name '*.map' -type f -delete || true",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "sentry",
    "react",
    "error-tracking",
    "monitoring"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "@sentry/vite-plugin": "^4.6.0",
    "@sentry/webpack-plugin": "^4.6.0"
  },
  "dependencies": {
    "@sentry/react": "^10.25.0",
    "react-error-boundary": "^6.0.0",
    "glob": "^11.0.0",
    "dotenv": "^16.4.5"
  },
  "bin": {
    "channelwill-sentry-cli": "./dist/cli.js"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/react": "^18.2.43 || ^19.0.0",
    "@types/react-dom": "^18.2.17 || ^19.0.0",
    "@types/node": "^20.0.0",
    "@sentry/vite-plugin": "^4.6.0",
    "@sentry/webpack-plugin": "^4.6.0",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "@sentry/cli": "^2.40.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  }
}
